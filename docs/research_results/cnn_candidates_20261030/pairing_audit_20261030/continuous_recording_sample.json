    },
    {
      "sentence_id": "114",
      "matlab_sentence_index": 115,
      "text": "His most important scientific work is his Zoonomia (1794-1796), which contains a system of pathology, and a treatise on \"generation,\" in which he, in the words of his famous grandson, Charles Robert Darwin, anticipated the views of Jean-Baptiste Lamarck, who in turn is regarded to have foreshadowed the theory of evolution.",
      "matlab_start_sample": 37101,
      "matlab_end_sample": 40305,
      "n_samples": 3205,
      "near_start_events": [
