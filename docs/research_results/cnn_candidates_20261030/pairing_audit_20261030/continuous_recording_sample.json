        {
          "type": "10  ",
          "matlab_latency": 57276.0
        }
      ]
    },
    {
      "sentence_id": "123",
      "matlab_sentence_index": 124,
      "text": "He also was awarded the Presidential Medal of Freedom.",
      "matlab_start_sample": 57276,
      "matlab_end_sample": 58159,
      "n_samples": 884,
      "near_start_events": [
        {
          "type": "11  ",
