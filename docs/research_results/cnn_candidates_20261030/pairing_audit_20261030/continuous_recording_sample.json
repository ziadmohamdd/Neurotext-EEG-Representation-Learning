          "matlab_latency": 61219.0
        }
      ]
    },
    {
      "sentence_id": "125",
      "matlab_sentence_index": 126,
      "text": "The organization's nonviolent principles were criticized by the younger, more radical blacks and challenged by the Student Nonviolent Coordinating Committee (SNCC) then headed by James Foreman.",
      "matlab_start_sample": 61222,
      "matlab_end_sample": 63779,
      "n_samples": 2558,
      "near_start_events": [
