        }
      ]
    },
    {
      "sentence_id": "117",
      "matlab_sentence_index": 118,
      "text": "On May 23, 1953, she married Robert Sargent Shriver, Jr., who was U.S. ambassador to France from 1968 to 1970, and was Democratic vice-presidential candidate in 1972.",
      "matlab_start_sample": 43076,
      "matlab_end_sample": 46014,
