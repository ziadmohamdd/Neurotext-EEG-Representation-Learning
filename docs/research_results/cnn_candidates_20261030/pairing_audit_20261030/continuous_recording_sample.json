        }
      ]
    },
    {
      "sentence_id": "131",
      "matlab_sentence_index": 132,
      "text": "She and her husband moved to Hollywood, California to pursue a career in motion pictures and in 1947, as \"Gail Davis,\" she made her motion picture debut in a comedy film short.",
      "matlab_start_sample": 74307,
