    },
    {
      "sentence_id": "130",
      "matlab_sentence_index": 131,
      "text": "Gail Davis (born October 5, 1925; died March 15, 1997) was an American actress.",
      "matlab_start_sample": 72706,
      "matlab_end_sample": 74304,
      "n_samples": 1599,
      "near_start_events": [
