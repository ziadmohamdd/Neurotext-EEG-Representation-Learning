      ]
    },
    {
      "sentence_id": "134",
      "matlab_sentence_index": 135,
      "text": "In 1950, she began to guest star in television Westerns, notably in the \"Lone Ranger\" and \"Cisco Kid\" series plus more than a dozen appearances on the \"Gene Autry Show\".",
      "matlab_start_sample": 80755,
      "matlab_end_sample": 83097,
      "n_samples": 2343,
