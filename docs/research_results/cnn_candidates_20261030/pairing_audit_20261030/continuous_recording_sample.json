        }
      ]
    },
    {
      "sentence_id": "129",
      "matlab_sentence_index": 130,
      "text": "He received his Ph.D. in Systematic theology from Boston University in 1955.",
      "matlab_start_sample": 69757,
      "matlab_end_sample": 71832,
