    },
    {
      "sentence_id": "138",
      "matlab_sentence_index": 139,
      "text": "She had been singing and dancing since childhood and after graduating from high scool in Little Rock, she went to study drama at girl's college in Bryn Mawr, Pennsylvania before completing her education at the University of Texas in Austin.",
      "matlab_start_sample": 90673,
