      ]
    },
    {
      "sentence_id": "133",
      "matlab_sentence_index": 134,
      "text": "Between then and 1953, Davis appeared in more than three dozen films, of which all but three were in the Western genre and that included fourteen films with the singing cowboy star, Gene Autry.",
      "matlab_start_sample": 78060,
      "matlab_end_sample": 80752,
