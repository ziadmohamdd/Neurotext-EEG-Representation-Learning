        }
      ]
    },
    {
      "sentence_id": "115",
      "matlab_sentence_index": 116,
      "text": "Eunice Mary Kennedy Shriver (born July 10, 1921 in Brookline, Massachusetts) is a member of the Kennedy family.",
      "matlab_start_sample": 40308,
      "matlab_end_sample": 41673,
      "n_samples": 1366,
