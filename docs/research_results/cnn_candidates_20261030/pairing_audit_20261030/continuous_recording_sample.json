    },
    {
      "sentence_id": "140",
      "matlab_sentence_index": 141,
      "text": "Elvis Aron Presley (January 8, 1935 - August 16, 1977), also known as The King of Rock and Roll (sometimes shortened to The King) was an American singer and actor.",
      "matlab_start_sample": 95404,
      "matlab_end_sample": 97438,
