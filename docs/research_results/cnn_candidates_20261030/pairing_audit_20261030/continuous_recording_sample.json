    },
    {
      "sentence_id": "122",
      "matlab_sentence_index": 123,
      "text": "The Reverend Martin Luther King, Jr. Ph.D., Boston University (January 15, 1929 - April 4, 1968) was an American Nobel Laureate, Baptist minister, and African American civil rights activist.",
      "matlab_start_sample": 54553,
      "matlab_end_sample": 57275,
      "n_samples": 2723,
      "near_start_events": [
        {
          "type": "10  ",
