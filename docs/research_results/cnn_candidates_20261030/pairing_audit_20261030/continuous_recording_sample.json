          "type": "10  ",
          "matlab_latency": 46016.0
        }
      ]
    },
    {
      "sentence_id": "118",
      "matlab_sentence_index": 119,
      "text": "She actively campaigned for her brother John F. Kennedy, and supported Arnold Schwarzenegger's successful bid for governor of California in 2003.",
      "matlab_start_sample": 46016,
      "matlab_end_sample": 47850,
      "n_samples": 1835,
      "near_start_events": [
        {
          "type": "11  ",
