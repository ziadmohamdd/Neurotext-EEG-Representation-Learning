        }
      ]
    },
    {
      "sentence_id": "127",
      "matlab_sentence_index": 128,
      "text": "He graduated from Morehouse College with a Bachelor of Arts degree in Sociology in 1948.",
      "matlab_start_sample": 65521,
      "matlab_end_sample": 66843,
      "n_samples": 1323,
      "near_start_events": [
