        }
      ]
    },
    {
      "sentence_id": "116",
      "matlab_sentence_index": 117,
      "text": "Her father was Joseph P. Kennedy, Sr., and her mother was Rose Kennedy.",
      "matlab_start_sample": 41676,
      "matlab_end_sample": 43074,
      "n_samples": 1399,
      "near_start_events": [
