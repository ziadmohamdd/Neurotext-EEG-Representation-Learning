        }
      ]
    },
    {
      "sentence_id": "128",
      "matlab_sentence_index": 129,
      "text": "His application to Yale Divinity School was rejected, and he graduated from Crozer Theological Seminary in Chester, Pennsylvania [1] with a Bachelor of Divinity in 1951.",
      "matlab_start_sample": 66846,
      "matlab_end_sample": 69756,
