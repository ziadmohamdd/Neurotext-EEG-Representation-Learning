          "matlab_latency": 63781.0
        }
      ]
    },
    {
      "sentence_id": "126",
      "matlab_sentence_index": 127,
      "text": "King was born in Atlanta, Georgia to the Rev. Martin Luther King, Sr. and Alberta Williams King.",
      "matlab_start_sample": 63781,
      "matlab_end_sample": 65519,
      "n_samples": 1739,
      "near_start_events": [
