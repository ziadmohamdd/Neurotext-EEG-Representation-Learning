    },
    {
      "sentence_id": "121",
      "matlab_sentence_index": 122,
      "text": "In 1953, King became the pastor of the Dexter Avenue Baptist Church in Montgomery, Alabama.",
      "matlab_start_sample": 53000,
      "matlab_end_sample": 54550,
      "n_samples": 1551,
      "near_start_events": [
