        }
      ]
    },
    {
      "sentence_id": "120",
      "matlab_sentence_index": 121,
      "text": "The wedding ceremony took place in Scott's parents' house in Marion, Alabama, and was performed by King's father.",
      "matlab_start_sample": 49109,
      "matlab_end_sample": 51134,
      "n_samples": 2026,
