    },
    {
      "sentence_id": "132",
      "matlab_sentence_index": 133,
      "text": "She then appeared in minor roles in another four films until landing a supporting role under star Roy Rogers in a 1948 Western film called The Far Frontier.",
      "matlab_start_sample": 76415,
      "matlab_end_sample": 78056,
      "n_samples": 1642,
